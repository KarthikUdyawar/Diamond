# =============================================================================
# Diamond — Environment Variables
# Copy this file:  cp .env.example .env
# Fill in your values. NEVER commit .env to version control.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=diamond
POSTGRES_PASSWORD=diamond_secret
POSTGRES_DB=diamond_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- MLflow ---
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=diamond-price

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Streamlit ---
STREAMLIT_PORT=8501

# --- Kaggle (required for: make download) ---
# Get your token at: https://www.kaggle.com/settings → API → Create New Token
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
