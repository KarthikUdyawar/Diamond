# =============================================================================
# Diamond — Environment Variables Template
# =============================================================================
#
# Three environments are supported. Copy this file to the target:
#
#   cp .env.example .env.local    ← local development
#   cp .env.example .env.testing  ← pytest / CI
#   cp .env.example .env.staging  ← Docker Compose (edit host/URIs)
#
# .env is kept as an alias / symlink for .env.local so tools that
# expect a plain .env file (e.g. some IDE plugins) still work.
#
# HOW TO ACTIVATE:
#   uv run:     uv run --env-file .env.local    -m src.features
#               uv run --env-file .env.testing  -m pytest
#   Docker:     env_file: .env.staging  (set in docker-compose.yml)
#
# All three files are gitignored. Only this template is committed.
# =============================================================================

# ── Environment identity ──────────────────────────────────────────────────────
# Controls log renderer (pretty vs JSON) and strictness checks.
# Values: local | testing | staging
APP_ENV=local

# ── Logging ───────────────────────────────────────────────────────────────────
# local:   DEBUG    (verbose, coloured, human-readable)
# testing: WARNING  (quiet during pytest runs)
# staging: INFO     (JSON, machine-readable)
LOG_LEVEL=DEBUG

# ── MLflow ────────────────────────────────────────────────────────────────────
# local:   http://localhost:5000
# staging: http://mlflow:5000   ← Docker service name
# testing: http://localhost:5000 (mocked in unit tests)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=diamond-price

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# local/testing: localhost
# staging:       postgres  ← Docker service name
POSTGRES_USER=diamond
POSTGRES_PASSWORD=changeme
POSTGRES_DB=diamond
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Kaggle API ────────────────────────────────────────────────────────────────
# Required only for `make download`. Leave empty in testing / CI.
# https://www.kaggle.com/settings → API → Create New Token
KAGGLE_USERNAME=
KAGGLE_KEY=

# ── SHAP ──────────────────────────────────────────────────────────────────────
# local/staging: 200 (default, accurate)
# testing:       10  (fast, keeps unit tests quick)
SHAP_BACKGROUND_ROWS=200
SHAP_POSITIVE_COLOR=#2a9d8f
SHAP_NEGATIVE_COLOR=#e76f51
SHAP_RANDOM_STATE=42

# ── Model ─────────────────────────────────────────────────────────────────────
MODEL_REGISTRY_NAME=Diamond
MODEL_CONFIDENCE_PCT=0.08
OPTUNA_N_TRIALS=50
TRAIN_TEST_SPLIT_SIZE=0.2
RANDOM_STATE=42

# ── Paths (optional overrides — defaults derived from project root) ────────────
# RAW_DATA_DIR=data/raw
# PROCESSED_DIR=data/processed
